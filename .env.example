# ColdLedger configuration. Copy to .env and adjust if needed.

# TimescaleDB connection (matches docker-compose.yml)
COLDLEDGER_DSN=postgresql://coldledger:coldledger@localhost:5433/coldledger

# Breach rule
BREACH_THRESHOLD_C=5.0
BREACH_SUSTAIN_MINUTES=10

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=cold-ledger

# Optional blip-vs-breach decider (deferred by default, see NOTES.md)
DECIDER_ENABLED=0
